+// Enqueue only -- callable from ANY fiber. See the emitQueue_ comment in
+// protocol.h for why this must not touch a transport directly.
+//
+// Ordering: lines still leave in the order they were emitted; they are now
+// handed to the wire by the protocol fiber on its next pass round run()'s
+// loop, so a line can sit here for up to kPollIntervalMs (5 ms) longer than
+// before. Relative order is preserved exactly, including against the
+// protocol fiber's own replies, because there is now only one drainer.
+//
+// Loss: a line is dropped ONLY if kEmitSlots (6) lines are already waiting
+// when this is called -- i.e. a burst emitted faster than 5 ms. The old code
+// could not drop here, but it could wedge the port permanently, losing every
+// subsequent line; a counted drop under burst is the better failure.
 void Protocol::emitLine(const char* text) {
   if (text == nullptr) return;
   size_t len = 0;
+  while (text[len] != '\0' && len < RadioTransport::kMaxPayloadBytes) ++len;
+  if (len == 0) return;
+
+  // Straight-line, no blocking call: under CODAL's cooperative scheduler
+  // this cannot be interleaved with another fiber's enqueue, and no ISR
+  // reaches emitLine(), so no IRQ masking is needed.
+  const uint8_t head = emitHead_;
+  const uint8_t next = static_cast<uint8_t>((head + 1) % kEmitSlots);
+  if (next == emitTail_) {   // ring full
+    ++emitDropCount_;
+    return;
+  }
+  std::memcpy(emitQueue_[head], text, len);
+  emitQueue_[head][len] = '\0';
+  emitHead_ = next;
+}
+
+// Protocol fiber only.
+void Protocol::drainEmitQueue() {
+  while (emitTail_ != emitHead_) {
+    emitLineNow(emitQueue_[emitTail_]);
+    emitTail_ = static_cast<uint8_t>((emitTail_ + 1) % kEmitSlots);
+  }
+}
