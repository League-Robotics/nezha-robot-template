{
    "name": "nezha-robot-template",
    "version": "1.0.0",
    "description": "MakeCode project template for driving the Nezha robot with the DiffDrive extension. Start here to write JavaScript programs that move, turn, and navigate.",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "nezha-diffdrive": "github:League-Robotics/pxt-nezha-diffdrive#v1.20260909.1",
        "pxt-PlanetX": "github:elecfreaks/pxt-PlanetX#v1.6.7",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "test/secrets.ts",
        "test/support.ts",
        "test/square.ts",
        "test/circle.ts",
        "test/calibratex.ts",
        "test/calibratea.ts",
        "test/spin.ts",
        "test/linetrack.ts",
        "test/obstacle1.ts",
        "test/boot.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit_radio_max_packet_size": 250,
            "device_ble": 0
        }
    },
    "disablesVariants": [
        "mbdal"
    ]
}
