#!/usr/bin/env python3
"""radio-address-dump -- protocol v1, one file per repository.

Contract (defined in microbit-radio-relay/tools/radio-address-dump, checked by
its scripts/radio_address_conformance.py):

    tools/radio-address-dump --list
        one implementation id per line
    tools/radio-address-dump <id> [1|2]
        the spec's canonical form for n = 0..3124 in order, 3125 lines, exit 0.
        v2 (default): "<name>,<channel>,<group>,<decode(name)>,<reverse(channel,group)>",
        whose sha256 is the spec's D2; "1" selects the three-column D1 form.
        Exits 3, with one line on stderr, when the implementation cannot run here.

The map and its digests are defined by radio-robot-lib docs/design/radio-addressing.md.

This repository's implementations:
    makecode-ts    test/boot.ts's own nameValue() and radioAddressFromName() --
                   the code the calibration image runs at boot to tune its
                   radio -- lifted out of the MakeCode source and run under
                   node. The firmware has no reverse map, so the v2 reverse
                   column is leaguebot's radioAddressToName() applied to
                   boot.ts's pair: a D2 pass therefore also proves that pair
                   leads back to the right name.
    leaguebot-js   leaguebot/src/radio.js, the pair leaguebot tunes relays to
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
UNAVAILABLE = 3

MAKECODE_TS = r"""
const [bootPath, radioPath, version] = process.argv.slice(1);
const fs = await import("node:fs");
const radio = await import(radioPath);
const src = fs.readFileSync(bootPath, "utf8");
function lift(name) {
    const start = src.indexOf(`function ${name}(`);
    if (start < 0) throw new Error(`test/boot.ts has no function ${name}()`);
    const end = src.indexOf("\n}\n", start);
    return src.slice(start, end + 2);
}
// boot.ts is MakeCode static TypeScript; its only annotations are parameter
// and return types, which is all that has to go for node to run it as-is.
const code = (lift("nameValue") + "\n" + lift("radioAddressFromName"))
    .replace(/\((\w+): string\)/g, "($1)")
    .replace(/\):\s*number(\[\])?\s*\{/g, ") {");
const boot = new Function(`${code}\nreturn { nameValue, radioAddressFromName };`)();
let out = "";
for (let n = 0; n < 3125; n += 1) {
    const name = radio.valueToName(n);
    const [channel, group] = boot.radioAddressFromName(name);
    out += version === "1"
        ? `${name},${channel},${group}\n`
        : `${name},${channel},${group},${boot.nameValue(name)},${radio.nameToValue(radio.radioAddressToName(channel, group))}\n`;
}
process.stdout.write(out);
"""

LEAGUEBOT_JS = r"""
const [radioPath, version] = process.argv.slice(1);
const radio = await import(radioPath);
process.stdout.write(radio.canonicalForm(Number(version)));
"""


def run_node(script: str, args: list[str]) -> int:
    node = shutil.which("node")
    if node is None:
        print("no node on PATH", file=sys.stderr)
        return UNAVAILABLE
    run = subprocess.run([node, "--input-type=module", "-e", script, *args], capture_output=True, text=True)
    sys.stdout.write(run.stdout)
    sys.stderr.write(run.stderr)
    return run.returncode


def radio_module() -> str:
    return (ROOT / "leaguebot" / "src" / "radio.js").as_uri()


def dump_makecode_ts(version: int) -> int:
    return run_node(MAKECODE_TS, [str(ROOT / "test" / "boot.ts"), radio_module(), str(version)])


def dump_leaguebot_js(version: int) -> int:
    return run_node(LEAGUEBOT_JS, [radio_module(), str(version)])


IMPLEMENTATIONS = {
    "makecode-ts": dump_makecode_ts,
    "leaguebot-js": dump_leaguebot_js,
}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help") or len(argv) > 2:
        print(__doc__, file=sys.stderr)
        return 2
    if argv[0] == "--list":
        print("\n".join(IMPLEMENTATIONS))
        return 0
    impl = IMPLEMENTATIONS.get(argv[0])
    if impl is None:
        print(f"unknown implementation {argv[0]!r}; try --list", file=sys.stderr)
        return 2
    version = int(argv[1]) if len(argv) == 2 else 2
    if version not in (1, 2):
        print("version must be 1 or 2", file=sys.stderr)
        return 2
    return impl(version)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
