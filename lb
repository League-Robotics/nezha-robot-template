#!/usr/bin/env bash
# lb — shorthand for leaguebot: find, drive and calibrate the robots.
#
# Usage:
#   ./lb probe                 # every robot on USB and on the network
#   ./lb probe gopiv           # which paths reach one robot
#   ./lb connect gopiv         # menu: list the robot's functions, run one
#   ./lb calibrate gopiv       # the wheel and turn calibration runs
#   ./lb show                  # what is in calibration.json
#   ./lb --help                # everything else
#
# Everything is passed straight through to leaguebot/bin/leaguebot.js, so any
# flag that works there works here -- `./lb probe -v` included.
#
# Resolves its own directory rather than trusting the caller's, so `./lb` and
# `~/proj/.../lb` and a symlink from somewhere on PATH all behave the same. The
# calibration file is the one exception: it is deliberately written to the
# directory you ran from, not to the repo, so calibrating from the playfield
# laptop leaves its results where you are working.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOT="$HERE/leaguebot"

# The dependencies are native (serialport) and are NOT part of the pxt project's
# own node_modules, so a fresh clone has to install them once. Doing it here
# rather than making the operator remember `npm run leaguebot:setup` -- the
# first thing anyone types is `./lb probe`, not the setup command.
if [ ! -d "$BOT/node_modules/serialport" ]; then
    echo "lb: installing leaguebot's dependencies (first run only)..." >&2
    npm install --prefix "$BOT" --no-audit --no-fund >&2
fi

# Tell the CLI what to call itself, so `./lb --help` says `./lb`.
export LEAGUEBOT_NAME="${LEAGUEBOT_NAME:-$0}"

exec node "$BOT/bin/leaguebot.js" "$@"
