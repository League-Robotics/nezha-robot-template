// Dev container for Nezha robot development.
// Pre-installs Node, PXT/MakeCode CLI, and Docker for local compilation.
// On create: installs project deps + micro:bit target + extension deps
// so IntelliSense and builds work immediately.
{
    "name": "Nezha Robot (MakeCode + micro:bit)",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:20",

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": false
        }
    },

    "containerEnv": {
        "PXT_FORCE_LOCAL": "1",
        "PXT_COMPILE_SWITCHES": "csv---mbcodal"
    },

    // Install project deps so IntelliSense types are available immediately.
    // Docker pull is best-effort — Codespaces may not have Docker ready yet.
    "postCreateCommand": "npm install && npx pxt target microbit && npx pxt install && (docker pull ghcr.io/league-microbit/yotta-compiler:latest && docker tag ghcr.io/league-microbit/yotta-compiler:latest pext/yotta:latest || true)",

    "forwardPorts": [3232],
    "portsAttributes": {
        "3232": {
            "label": "MakeCode Editor",
            "onAutoForward": "notify"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.makecode-tools"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "files.exclude": {
                    "yotta_modules": true,
                    "yotta_targets": true,
                    "node_modules": true,
                    ".pxt": true,
                    "built": true
                }
            }
        }
    }
}