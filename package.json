{
    "version": "1.0.0",
    "scripts": {
        "setup": "npm install --no-audit --no-fund && npx --yes pxt target microbit && npx --yes pxt install",
        "leaguebot": "node leaguebot/bin/leaguebot.js",
        "leaguebot:setup": "npm install --prefix leaguebot --no-audit --no-fund",
        "leaguebot:test": "node --test leaguebot/test/*.test.js",
        "build": "bash scripts/build.sh",
        "build:cloud": "bash scripts/build.sh --cloud",
        "deploy": "bash scripts/deploy.sh",
        "deploy:cloud": "bash scripts/deploy.sh --cloud",
        "flash": "bash scripts/deploy.sh --flash-only",
        "code": "bash scripts/code.sh",
        "update": "bash scripts/update.sh",
        "docker:pull": "docker pull ghcr.io/league-microbit/yotta-compiler:latest && docker tag ghcr.io/league-microbit/yotta-compiler:latest pext/yotta:latest",
        "clean": "rm -rf built/ pxt_modules/ yotta_modules/ yotta_targets/ .pxt/ *.hex"
    },
    "dependencies": {
        "pxt-microbit": "^9.1.1"
    },
    "devDependencies": {
        "pxt": "^0.5.1",
        "typescript": "^5.9.3"
    }
}
