{
    "version": "1.0.0",
    "scripts": {
        "setup":       "npm install --no-audit --no-fund && npx --yes pxt target microbit && npx --yes pxt install",
        "build":       "bash scripts/build.sh",
        "build:cloud": "bash scripts/build.sh --cloud",
        "deploy":      "bash scripts/deploy.sh",
        "deploy:cloud":"bash scripts/deploy.sh --cloud",
        "code":        "bash scripts/code.sh",
        "clean":       "rm -rf built/ pxt_modules/ yotta_modules/ yotta_targets/ .pxt/ *.hex"
    },
    "dependencies": {
        "pxt-microbit": "^9.1.1"
    },
    "devDependencies": {
        "pxt": "^0.5.1",
        "typescript": "^5.9.3"
    }
}